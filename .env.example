# ==============================================================
# VARIABLES D'ENVIRONNEMENT FRONTEND (Next.js - Vercel & Local)
# ==============================================================

# URL du backend Spring Boot
# En local : http://localhost:8080 (valeur par défaut automatique)
# Sur Vercel : https://votre-app-render.onrender.com
BACKEND_URL=http://localhost:8080

# Cloudinary (Upload gratuit des photos de vêtements & constats RG16)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=votre_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=votre_upload_preset
